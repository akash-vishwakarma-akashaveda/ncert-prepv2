generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
}

enum DoubtStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum FeedbackStatus {
  NEW
  REVIEWED
}

enum XpSourceType {
  LESSON_COMPLETED
  LESSON_UNCOMPLETED
  FOCUS_SESSION
  STREAK_BONUS
  NOTES_REVISION
  DOUBT_ASKED
  WELCOME_BONUS
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  googleId         String?       @unique
  passwordHash     String?
  emailVerified    Boolean       @default(false)
  // Bumped on "log out of all devices" and password reset; embedded in the session JWT and
  // checked on every request, so older tokens issued before the bump stop working immediately.
  sessionVersion   Int           @default(0)
  role             Role          @default(STUDENT)
  // Every account gets one, generated at creation; shareable so others can enter it at signup.
  referralCode     String?       @unique
  // The code THIS user typed in at registration, if any (null for Google sign-ins and organic signups).
  referredByCode   String?
  classGrade       Int?
  displayName      String?
  photoUrl         String?
  phoneNumber      String?
  xp               Int           @default(0)
  streak           Int           @default(0)
  lastActiveDate   String?
  lastWatchedVideo String?
  studyGoalMinutes Int?
  onboardingCompleted Boolean    @default(false)
  focusSubjects    String[]      @default([])
  // Classes 11-12 split into streams (science/commerce/humanities). Null for classes 1-10, and
  // for seniors who have not picked one: the catalog still shows every subject either way.
  stream           String?

  consentStatus       ConsentStatus @default(PENDING)
  consentAgeGroup      String?
  consentMethod        String?
  consentNoticeVersion String?
  consentLanguage      String?
  consentParentName    String?
  consentParentEmail   String?
  consentGrantedAt     DateTime?
  consentRequestedAt   DateTime?

  remindersEnabled Boolean       @default(false)
  reminderFrequency String       @default("daily")
  reminderHour     Int?
  // Set when a reminder email is claimed for sending; stops a second send in the same slot.
  lastReminderAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lessonProgress  LessonProgress[]
  xpTransactions  XpTransaction[]
  doubts          Doubt[]
  feedback        Feedback[]
  consentRequests ConsentRequest[]

  @@index([classGrade, xp])
  @@index([referredByCode])
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeId String
  completed Boolean  @default(false)
  favorited Boolean  @default(false)
  watchedAt DateTime @default(now())

  @@unique([userId, youtubeId])
}

model XpTransaction {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        XpSourceType
  description String
  // Idempotency key: youtubeId for lesson completion, "focus_<isoDay>_<ts>" for focus sessions,
  // "streak_<isoDay>" for the once-a-day streak bonus.
  sourceId    String?
  // XP is scoped to the class the lesson/session belongs to, not the student's whole account.
  classSort   String
  // Running per-class balance at write time (never below 0) — avoids recomputing on every read.
  balanceAfter Int
  createdAt   DateTime     @default(now())

  @@index([userId, classSort, createdAt])
  @@index([userId, sourceId, type])
}

model Video {
  youtubeId    String  @id

  // Sheet-managed fields (overwritten on every sync)
  classSort    String  // e.g. "09"  (zero-padded)
  classDisplay String  // e.g. "Class IX"
  subject      String
  textbook     String  @default("")
  chapterId    String  // e.g. "Chapter 1"
  chapterName  String
  videoTitle   String
  ytPublic     Boolean @default(true)   // false = not yet public on YouTube
  pdfUrl       String  @default("")
  timestamps   String  @default("")     // "mm:ss – topic" lines

  // Admin-only flags (never overwritten by sync)
  isActive     Boolean @default(true)
  isPremium    Boolean @default(false)
  pyqAvailable Boolean @default(false)

  // Change-detection: SHA-256 of all sheet fields, updated on sync
  contentHash  String  @default("")

  syncedAt     DateTime @default(now())

  @@index([classSort, subject, chapterId])
}

// Daily per-video watched-seconds rollup, fed by short heartbeat pings from the player while it's
// actually playing (not just loaded). Approximate by design — good enough to estimate watch-hours
// for a revenue estimate, not a frame-accurate analytics pipeline.
model VideoWatchStat {
  id             String   @id @default(uuid())
  youtubeId      String
  day            String   // 'YYYY-MM-DD', UTC
  secondsWatched Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([youtubeId, day])
  @@index([day])
}

// Flat, denormalized admin overlays on top of video-derived data — not a strict FK hierarchy,
// since a subject/chapter record can exist before (or without) a matching class record. IDs are
// client-generated deterministic keys (see frontend data/curriculumKeys.ts), not server UUIDs, so
// re-saving the same logical record is idempotent by design (matches the old Firestore doc-id scheme).
model CurriculumClass {
  id          String   @id // classSort, e.g. "09"
  classSort   String
  name        String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
}

model CurriculumSubject {
  id        String   @id // `${classSort}_${slug(name)}`
  classSort String
  name      String
  textbook  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model CurriculumChapter {
  id          String   @id // chapterKey(classSort, subject, chapterId, textbook)
  classSort   String
  subject     String
  textbook    String?
  chapterId   String
  chapterName String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model ChapterNote {
  id          String   @id // chapter key, same scheme as CurriculumChapter
  classSort   String
  subject     String
  chapterId   String
  chapterName String
  title       String
  summary     String
  keyPoints   String[] @default([])
  formulas    String[] @default([])
  examTips    String[] @default([])
  // NoteAttachment[] ({name,url,path,contentType,size,uploaded_at}) — a small, always-loaded-
  // together list with no independent query needs, so JSON beats a join table here.
  attachments Json     @default("[]")
  isPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model Doubt {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSort     String
  subject       String
  chapterId     String
  chapterName   String
  youtubeId     String
  videoTitle    String
  question      String
  status        DoubtStatus @default(OPEN)
  answer        String?
  answeredBy    String?
  answeredAt    DateTime?
  studentUnread Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeId String
  message   String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())

  @@index([status, createdAt])
}

model ConsentRequest {
  token     String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ConsentStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([status, expiresAt])
  @@index([userId])
}

model StatsDaily {
  day              String @id // YYYY-MM-DD, IST
  visitors         Int    @default(0)
  newVisitors      Int    @default(0)
  activeStudents   Int    @default(0)
  registrations    Int    @default(0)
  lessonsStarted   Int    @default(0)
  lessonsCompleted Int    @default(0)
  doubtsAsked      Int    @default(0)
}

model StatsTotal {
  id               String @id @default("totals")
  visitors         Int    @default(0)
  registrations    Int    @default(0)
  lessonsStarted   Int    @default(0)
  lessonsCompleted Int    @default(0)
  doubtsAsked      Int    @default(0)
}

model AppSetting {
  key   String @id
  value Json
}

model RateLimit {
  key       String   @id
  windowEnd DateTime
  count     Int      @default(1)
}
