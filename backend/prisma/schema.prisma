generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
}

enum DoubtStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum FeedbackStatus {
  NEW
  REVIEWED
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  googleId         String?       @unique
  passwordHash     String?
  emailVerified    Boolean       @default(false)
  role             Role          @default(STUDENT)
  classGrade       Int?
  displayName      String?
  photoUrl         String?
  phoneNumber      String?
  xp               Int           @default(0)
  streak           Int           @default(0)
  lastActiveDate   String?
  lastWatchedVideo String?
  studyGoalMinutes Int?
  onboardingCompleted Boolean    @default(false)
  focusSubjects    String[]      @default([])

  consentStatus       ConsentStatus @default(PENDING)
  consentAgeGroup      String?
  consentMethod        String?
  consentNoticeVersion String?
  consentLanguage      String?
  consentParentName    String?
  consentParentEmail   String?
  consentGrantedAt     DateTime?
  consentRequestedAt   DateTime?

  remindersEnabled Boolean       @default(false)
  reminderFrequency String       @default("daily")
  reminderHour     Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lessonProgress  LessonProgress[]
  xpTransactions  XpTransaction[]
  doubts          Doubt[]
  feedback        Feedback[]
  consentRequests ConsentRequest[]

  @@index([classGrade, xp])
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeId String
  completed Boolean  @default(false)
  favorited Boolean  @default(false)
  watchedAt DateTime @default(now())

  @@unique([userId, youtubeId])
}

model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Video {
  youtubeId    String  @id

  // Sheet-managed fields (overwritten on every sync)
  classSort    String  // e.g. "09"  (zero-padded)
  classDisplay String  // e.g. "Class IX"
  subject      String
  textbook     String  @default("")
  chapterId    String  // e.g. "Chapter 1"
  chapterName  String
  videoTitle   String
  ytPublic     Boolean @default(true)   // false = not yet public on YouTube
  pdfUrl       String  @default("")
  timestamps   String  @default("")     // "mm:ss – topic" lines

  // Admin-only flags (never overwritten by sync)
  isActive     Boolean @default(true)
  isPremium    Boolean @default(false)
  pyqAvailable Boolean @default(false)

  // Change-detection: SHA-256 of all sheet fields, updated on sync
  contentHash  String  @default("")

  syncedAt     DateTime @default(now())

  @@index([classSort, subject, chapterId])
}

model CurriculumClass {
  id       String              @id @default(uuid())
  name     String
  order    Int                 @default(0)
  subjects CurriculumSubject[]
}

model CurriculumSubject {
  id       String              @id @default(uuid())
  classId  String
  class    CurriculumClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  name     String
  order    Int                 @default(0)
  chapters CurriculumChapter[]
}

model CurriculumChapter {
  id        String            @id @default(uuid())
  subjectId String
  subject   CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  order     Int               @default(0)
}

model ChapterNote {
  id            String   @id @default(uuid())
  chapterKey    String   @unique
  classGrade    Int
  isPublished   Boolean  @default(false)
  attachmentUrl String?
  updatedAt     DateTime @updatedAt
}

model Doubt {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  status     DoubtStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  answeredAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())

  @@index([status, createdAt])
}

model ConsentRequest {
  token     String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ConsentStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([status, expiresAt])
  @@index([userId])
}

model StatsDaily {
  day           String @id
  registrations Int    @default(0)
  activeUsers   Int    @default(0)
}

model StatsTotal {
  id             String @id @default("totals")
  registrations  Int    @default(0)
  lessonsWatched Int    @default(0)
}

model AppSetting {
  key   String @id
  value Json
}

model RateLimit {
  key       String   @id
  windowEnd DateTime
  count     Int      @default(1)
}
