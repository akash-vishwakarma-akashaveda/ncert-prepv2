# Backend API (prep_ncert/backend). No /api suffix — every call path already includes it.
VITE_API_URL=http://localhost:4000

# Google Identity Services client ID (Google Cloud Console → Credentials). Same value goes in
# the backend's GOOGLE_CLIENT_ID. No client secret needed — verification happens server-side.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# DPDP grievance officer shown in the privacy notice
VITE_GRIEVANCE_OFFICER_NAME=Grievance Officer, NCERT Prep
VITE_GRIEVANCE_EMAIL=privacy@ncertprep.io
